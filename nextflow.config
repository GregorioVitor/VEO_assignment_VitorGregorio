/*
 * Default parameters. Every parameter is documented in nextflow_schema.json
 * (run `nextflow run . --help` for the full list).
 */
params {
    // Input / output
    input           = null
    outdir          = 'results'

    // Assembly
    flye_mode       = 'nano-raw'
    flye_meta       = false
    genome_size     = null

    // CheckV
    skip_checkv     = false
    checkv_db       = null
    checkv_db_cache = 'databases'

    // Execution
    publish_dir_mode = 'copy'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
        command = 'nextflow run GregorioVitor/VEO_assignment_VitorGregorio -profile docker --input samplesheet.csv --outdir results'
    }
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

manifest {
    name            = 'GregorioVitor/VEO_assignment_VitorGregorio'
    contributors    = [
        [
            name: 'Vitor Gregorio',
            github: '@GregorioVitor',
            contribution: ['author', 'maintainer'],
        ],
    ]
    homePage        = 'https://github.com/GregorioVitor/VEO_assignment_VitorGregorio'
    description     = 'Nanopore phage genome assembly and QC: NanoPlot, Flye, QUAST, CheckV and MultiQC'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '2.0.0'
}
