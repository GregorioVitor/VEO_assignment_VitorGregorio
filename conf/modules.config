/*
 * Per-process options: published outputs and extra tool arguments (ext.args).
 */
process {

    publishDir = [
        path: { "${params.outdir}/${task.process.toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename == 'versions.yml' ? null : filename },
    ]

    withName: NANOPLOT {
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: FLYE {
        ext.args = {
            [
                params.flye_meta   ? '--meta' : '',
                params.genome_size ? "--genome-size ${params.genome_size}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: QUAST {
        publishDir = [
            path: { "${params.outdir}/qc/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // The database is cached outside the results directory and reused across runs
    withName: CHECKV_DOWNLOADDATABASE {
        storeDir   = { params.checkv_db_cache }
        publishDir = [enabled: false]
    }

    withName: CHECKV_ENDTOEND {
        publishDir = [
            path: { "${params.outdir}/checkv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' || filename.endsWith('quality_summary.tsv') ? null : filename },
        ]
    }

    withName: MULTIQC {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }
}
