/*
 * Minimal test: two samples of simulated Nanopore reads from phage lambda
 * (see tests/data/README.md). Runs in a few minutes on a laptop or a GitHub runner.
 *
 *   nextflow run . -profile test,docker --outdir results
 *
 * CheckV is skipped because its database is about 1.4 GB. The full workflow,
 * CheckV included, is exercised by the stub test in tests/.
 */
params {
    input       = "${projectDir}/tests/data/samplesheet.csv"
    skip_checkv = true
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 15.GB,
        time: 1.h,
    ]
}
